# Base de datos EXCLUSIVA para la suite e2e (`npm run test:e2e`).
#
# ⚠️ La suite hace TRUNCATE de todas las tablas entre tests: nunca apuntes esta
# variable a tu base de desarrollo. El arranque se niega a correr si el nombre de la
# base (o del schema) no contiene "test".
#
# Si la base no existe, la suite intenta crearla; el usuario necesita permiso CREATEDB.
TEST_DATABASE_URL="postgresql://pdi:pdi@localhost:5432/pdi_test?schema=public"
