generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

enum KitStatus {
  ASSIGNED
  RETURNED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  /// Rol PRINCIPAL: el de mayor privilegio dentro de `roles`. Derivado y mantenido
  /// en sincronia en cada escritura; se conserva por compatibilidad y como default.
  role      Role
  /// FUENTE DE VERDAD de la autorizacion. Un usuario puede acumular varios roles
  /// (p. ej. un alumno que ademas es admin queda con [STUDENT, ADMIN]).
  roles     Role[]   @default([])
  googleId  String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupMemberships GroupMember[]
  coursesTaught    CourseProfessor[]
  loansGiven       Loan[]            @relation("LoanGivenBy")
  assistantRoles   CourseAssistant[] @relation("CourseAssistant")
  kitAcceptances   KitAcceptance[]   @relation("KitAcceptance")
  kitsVerified     Kit[]             @relation("KitVerifiedBy")
  returnsReceived  ReturnEvent[]     @relation("ReturnReceivedBy")

  discrepanciesResolved DiscrepancyResolution[] @relation("DiscrepancyResolvedBy")
  termsCreated          TermsVersion[]          @relation("TermsCreatedBy")
}

model Course {
  id        String   @id @default(cuid())
  name      String
  year      Int
  semester  Int
  createdAt DateTime @default(now())

  /// Documento de condiciones propio; si es null se usa el documento por defecto.
  termsDocumentId String?
  termsDocument   TermsDocument? @relation(fields: [termsDocumentId], references: [id])

  groups     Group[]
  professors CourseProfessor[]
  kits       Kit[]
  assistants CourseAssistant[]

  @@unique([name, year, semester])
}

model CourseAssistant {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  assistant   User     @relation("CourseAssistant", fields: [assistantId], references: [id], onDelete: Cascade)
  assistantId String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([courseId, assistantId])
}

model CourseProfessor {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  professor   User     @relation(fields: [professorId], references: [id], onDelete: Cascade)
  professorId String
  authorized  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([courseId, professorId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  createdAt DateTime @default(now())

  members GroupMember[]
  kits    Kit[]
  loans   Loan[]

  @@unique([name, courseId])
}

model GroupMember {
  id        String @id @default(cuid())
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  @@unique([groupId, studentId])
}

model Component {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Codigo interno del componente. Opcional, pero unico cuando existe.
  code        String?  @unique
  description String?
  totalStock  Int      @default(0)
  createdAt   DateTime @default(now())

  kitTemplateItems KitTemplateItem[]
  kitItems         KitItem[]
  loans            Loan[]
  tags             Tag[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Color hex opcional para pintar la etiqueta en la UI (ej. "#166499").
  color     String?
  createdAt DateTime @default(now())

  components Component[]
}

model KitTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  items KitTemplateItem[]
  kits  Kit[]
}

model KitTemplateItem {
  id          String      @id @default(cuid())
  template    KitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  component   Component   @relation(fields: [componentId], references: [id])
  componentId String
  quantity    Int

  @@unique([templateId, componentId])
}

model Kit {
  id         String       @id @default(cuid())
  code       String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  template   KitTemplate? @relation(fields: [templateId], references: [id])
  templateId String?
  status     KitStatus    @default(ASSIGNED)
  assignedAt DateTime     @default(now())
  returnedAt DateTime?

  /// Verificacion GRUPAL de la entrega: la hace un integrante, una sola vez.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("KitVerifiedBy", fields: [verifiedById], references: [id])

  items       KitItem[]
  acceptances KitAcceptance[]

  @@unique([code, courseId])
}

model KitItem {
  id               String     @id @default(cuid())
  kit              Kit        @relation(fields: [kitId], references: [id], onDelete: Cascade)
  kitId            String
  component        Component? @relation(fields: [componentId], references: [id])
  componentId      String?
  componentName    String
  quantity         Int
  returnedQuantity Int        @default(0)

  /// Marcado por el alumno en la verificacion de entrega ("recibido conforme").
  verified         Boolean @default(false)
  /// Discrepancia reportada por el alumno. Se registra, NO ajusta cantidades ni stock.
  verificationNote String?

  returnEvents ReturnEvent[]
  resolutions  DiscrepancyResolution[]
}

/// Aceptacion INDIVIDUAL de las condiciones de prestamo: una fila por integrante.
model KitAcceptance {
  id           String   @id @default(cuid())
  kit          Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  kitId        String
  student      User     @relation("KitAcceptance", fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  acceptedAt   DateTime @default(now())
  /// Version del texto de condiciones vigente al aceptar (ver src/terms/loan-terms.ts).
  termsVersion String

  @@unique([kitId, studentId])
}

model Loan {
  id               String     @id @default(cuid())
  group            Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId          String
  component        Component? @relation(fields: [componentId], references: [id])
  componentId      String?
  componentName    String
  quantity         Int        @default(1)
  returnedQuantity Int        @default(0)
  photoUrl         String?
  note             String?
  loanedBy         User       @relation("LoanGivenBy", fields: [loanedById], references: [id])
  loanedById       String
  loanedAt         DateTime   @default(now())
  returnedAt       DateTime?

  returnEvents ReturnEvent[]
}

/// Que decidio el profesor/ayudante sobre una discrepancia reportada por el alumno.
/// `action` es texto (no enum) para poder ampliar el catalogo sin migrar el enum:
/// ACKNOWLEDGED | REPLACED | DEDUCTED | WRITE_OFF.
model DiscrepancyResolution {
  id           String   @id @default(cuid())
  kitItem      KitItem  @relation(fields: [kitItemId], references: [id], onDelete: Cascade)
  kitItemId    String
  action       String
  /// Unidades afectadas por esta resolucion (>= 1).
  quantity     Int
  /// Justificacion de la decision; obligatoria.
  note         String
  resolvedBy   User     @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id])
  resolvedById String
  createdAt    DateTime @default(now())

  @@index([kitItemId, createdAt])
}

/// Un evento por cada devolucion registrada (pueden ser parciales y en varios momentos).
/// Exactamente uno de {kitItemId, loanId} viene seteado; se valida en el servicio.
model ReturnEvent {
  id           String   @id @default(cuid())
  kitItem      KitItem? @relation(fields: [kitItemId], references: [id], onDelete: Cascade)
  kitItemId    String?
  loan         Loan?    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId       String?
  quantity     Int
  /// Observacion opcional de quien recibe (estado, danos, etc.).
  note         String?
  receivedBy   User     @relation("ReturnReceivedBy", fields: [receivedById], references: [id])
  receivedById String
  createdAt    DateTime @default(now())

  @@index([kitItemId, createdAt])
  @@index([loanId, createdAt])
}

/// Documento de condiciones de prestamo. Agrupa versiones inmutables.
/// Exactamente uno tiene isDefault=true: es el que se usa cuando un curso no
/// tiene documento propio.
model TermsDocument {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  versions TermsVersion[]
  courses  Course[]
}

/// Version de un documento. Una vez publicada (publishedAt != null) es INMUTABLE:
/// las firmas ya registradas deben poder apuntar siempre al texto que se leyo.
model TermsVersion {
  id          String        @id @default(cuid())
  document    TermsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String
  /// Etiqueta legible elegida por el admin: "1.0", "2026-02", etc.
  version     String
  title       String
  /// Cuerpo en markdown simple.
  body        String
  /// null = borrador; con fecha = publicada e inmutable.
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  createdById String
  createdBy   User          @relation("TermsCreatedBy", fields: [createdById], references: [id])

  @@unique([documentId, version])
  @@index([documentId, publishedAt])
}
