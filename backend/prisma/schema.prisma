generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

enum KitStatus {
  ASSIGNED
  RETURNED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  googleId  String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupMemberships GroupMember[]
  coursesTaught    CourseProfessor[]
  loansGiven       Loan[]            @relation("LoanGivenBy")
  assistantRoles   CourseAssistant[] @relation("CourseAssistant")
}

model Course {
  id        String   @id @default(cuid())
  name      String
  year      Int
  semester  Int
  createdAt DateTime @default(now())

  groups     Group[]
  professors CourseProfessor[]
  kits       Kit[]
  assistants CourseAssistant[]

  @@unique([name, year, semester])
}

model CourseAssistant {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  assistant   User     @relation("CourseAssistant", fields: [assistantId], references: [id], onDelete: Cascade)
  assistantId String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([courseId, assistantId])
}

model CourseProfessor {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  professor   User     @relation(fields: [professorId], references: [id], onDelete: Cascade)
  professorId String
  authorized  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([courseId, professorId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  createdAt DateTime @default(now())

  members GroupMember[]
  kits    Kit[]
  loans   Loan[]

  @@unique([name, courseId])
}

model GroupMember {
  id        String @id @default(cuid())
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  @@unique([groupId, studentId])
}

model Component {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Codigo interno del componente. Opcional, pero unico cuando existe.
  code        String?  @unique
  description String?
  totalStock  Int      @default(0)
  createdAt   DateTime @default(now())

  kitTemplateItems KitTemplateItem[]
  kitItems         KitItem[]
  loans            Loan[]
  tags             Tag[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Color hex opcional para pintar la etiqueta en la UI (ej. "#166499").
  color     String?
  createdAt DateTime @default(now())

  components Component[]
}

model KitTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  items KitTemplateItem[]
  kits  Kit[]
}

model KitTemplateItem {
  id          String      @id @default(cuid())
  template    KitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  component   Component   @relation(fields: [componentId], references: [id])
  componentId String
  quantity    Int

  @@unique([templateId, componentId])
}

model Kit {
  id         String       @id @default(cuid())
  code       String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  template   KitTemplate? @relation(fields: [templateId], references: [id])
  templateId String?
  status     KitStatus    @default(ASSIGNED)
  assignedAt DateTime     @default(now())
  returnedAt DateTime?

  items KitItem[]

  @@unique([code, courseId])
}

model KitItem {
  id               String     @id @default(cuid())
  kit              Kit        @relation(fields: [kitId], references: [id], onDelete: Cascade)
  kitId            String
  component        Component? @relation(fields: [componentId], references: [id])
  componentId      String?
  componentName    String
  quantity         Int
  returnedQuantity Int        @default(0)
}

model Loan {
  id               String     @id @default(cuid())
  group            Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId          String
  component        Component? @relation(fields: [componentId], references: [id])
  componentId      String?
  componentName    String
  quantity         Int        @default(1)
  returnedQuantity Int        @default(0)
  photoUrl         String?
  note             String?
  loanedBy         User       @relation("LoanGivenBy", fields: [loanedById], references: [id])
  loanedById       String
  loanedAt         DateTime   @default(now())
  returnedAt       DateTime?
}
