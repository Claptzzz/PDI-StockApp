# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:password@localhost:5432/pdi?schema=public"

# Conexión DIRECTA (sin pooler) usada por Prisma para las migraciones.
# OPCIONAL: si la omites, se usa DATABASE_URL. Necesaria en prod cuando la DB
# está detrás de un pooler (Neon/Supabase/pgBouncer): pon aquí la URL directa.
DIRECT_URL="postgresql://usuario:password@localhost:5432/pdi?schema=public"

# --- Autenticación ---
# Secreto para firmar los JWT (mínimo 16 caracteres).
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales de Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Autorización ---
# Lista de correos de administradores, separada por comas.
ADMIN_EMAILS="admin@universidad.cl,otro.admin@universidad.cl"

# Lista OPCIONAL de correos con rol PROFESSOR, separada por comas.
# Útil para pruebas o profes con correo no institucional (p.ej. @gmail.com).
# Si está vacía o ausente, se ignora (no rompe el arranque).
PROFESSOR_EMAILS=""

# --- Supabase Storage ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="loan-evidence"

# --- Frontend (CORS) ---
# Origen permitido para el frontend (Vite dev server por defecto).
FRONTEND_ORIGIN="http://localhost:5174"
