# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:password@localhost:5432/pdi?schema=public"

# --- Autenticación ---
# Secreto para firmar los JWT (mínimo 16 caracteres).
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales de Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Autorización ---
# Lista de correos de administradores, separada por comas.
ADMIN_EMAILS="admin@universidad.cl,otro.admin@universidad.cl"

# --- Supabase Storage ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="loan-evidence"