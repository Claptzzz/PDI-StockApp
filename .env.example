# ============================================================================
#  .env de la RAÍZ — usado por docker-compose.yml (dev) y docker-compose.prod.yml
#  Copia a `.env` (git-ignored) y completa los valores. NO subas secretos.
# ============================================================================

# --- Despliegue (solo docker-compose.prod.yml) ------------------------------
# Puerto que publica el contenedor `web` en el host. Es el ÚNICO puerto expuesto;
# detrás debe ir el reverse proxy con HTTPS de la universidad.
APP_PORT=8080

# Subpath bajo el que se sirve TODA la app (con barras inicial y final).
# "/" no está soportado por este contenedor: para la raíz se usa Vercel.
APP_BASE_PATH=/inventario/

# Tamaño máximo de subida (fotos de evidencia de los préstamos).
APP_MAX_BODY_SIZE=10M

# Prefijo de las rutas de la API en NestJS. Déjalo en "api" salvo que sepas
# lo que haces: nginx y el frontend lo asumen.
API_PREFIX=api

# --- Postgres (servicio db del compose) -------------------------------------
POSTGRES_USER=pdi
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=pdi

# Si usas el servicio `db` del compose puedes dejar estas dos vacías: se arman
# solas con las tres variables de arriba. Defínelas solo para apuntar a un
# Postgres externo (institucional, Neon, etc.).
# DATABASE_URL="postgresql://usuario:clave@postgres.ucn.cl:5432/pdi?schema=public"
# DIRECT_URL="postgresql://usuario:clave@postgres.ucn.cl:5432/pdi?schema=public"

# --- Autenticación ----------------------------------------------------------
# Secreto para firmar los JWT (mínimo 16 caracteres). Genera uno aleatorio:
#   openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales de Google OAuth 2.0.
# IMPORTANTE: en Google Cloud Console hay que registrar el ORIGEN del dominio
# final (https://midominio.ucn.cl) en "Authorized JavaScript origins".
# El path (/inventario/) NO se incluye: solo cuenta el origen.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Autorización -----------------------------------------------------------
# Correos que reciben rol ADMIN, separados por comas (al menos uno).
ADMIN_EMAILS="admin@ucn.cl"
# Correos con rol PROFESSOR que no estén en el dominio institucional (opcional).
PROFESSOR_EMAILS=""

# --- CORS -------------------------------------------------------------------
# En el despliegue con Docker el SPA y la API comparten origen: déjalo VACÍO.
# Solo se usa si sirves el frontend desde otro dominio (p. ej. Vercel -> Azure).
FRONTEND_ORIGIN=""

# --- Supabase Storage (fotos de evidencia) ----------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="loan-evidence"
