# ============================================================================
#  .env de la RAÍZ — usado solo por docker-compose.yml
#  Copia a `.env` (git-ignored) y completa los valores. NO subas secretos.
# ============================================================================

# --- Postgres (servicio db del compose) ---
POSTGRES_USER=pdi
POSTGRES_PASSWORD=pdi
POSTGRES_DB=pdi

# --- Backend ---
# OJO: dentro de docker-compose el host de la DB es "db" (nombre del servicio),
# NO localhost.
DATABASE_URL="postgresql://pdi:pdi@db:5432/pdi?schema=public"
# Conexión directa para migraciones (sin pooler). Si la omites, cae a DATABASE_URL.
DIRECT_URL="postgresql://pdi:pdi@db:5432/pdi?schema=public"

JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

ADMIN_EMAILS="admin@universidad.cl"
PROFESSOR_EMAILS=""

# Origen(es) permitido(s) para CORS. Lista separada por comas.
FRONTEND_ORIGIN="http://localhost:5174"

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="loan-evidence"
