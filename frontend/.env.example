# --- Frontend (se inyectan en tiempo de BUILD) ---

# URL RAÍZ del backend, SIN el prefijo /api (el cliente lo añade solo).
# Déjala vacía en el despliegue con Docker + nginx: el SPA llamará por ruta
# relativa al mismo origen y no hará falta CORS.
VITE_API_URL="http://localhost:3000"

# Prefijo de la API. DEBE coincidir con API_PREFIX del backend (default "api").
# Ponlo vacío solo si el backend sirve en la raíz (API_PREFIX="").
VITE_API_PREFIX="api"

# Subpath bajo el que se sirve la app, con barras inicial y final.
# "/" (default) = raíz, que es como se despliega en Vercel.
VITE_BASE_PATH="/"

# Client ID de Google. En el despliegue con Docker se prefiere la config de
# runtime (config.js), que no obliga a reconstruir la imagen.
VITE_GOOGLE_CLIENT_ID=""
